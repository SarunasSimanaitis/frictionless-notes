{
  "expo": {
    "name": "Lapelis",
    "slug": "frictionless-notes",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Lapelis to add photos to your custom notes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Lapelis to use Face ID to unlock your notes."
        }
      ],
      "expo-system-ui"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.frictionlessnotes.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.frictionlessnotes.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#3B5BFF",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d88c7cb7-35fa-4692-b7de-dbde4425f928"
      }
    }
  }
}
