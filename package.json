{
  "name": "frictionless-notes",
  "description": "A personal productivity app for notes, checklists and everyday tasks.",
  "license": "0BSD",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@10play/tentap-editor": "^1.1.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tiptap/extension-horizontal-rule": "3.33.1",
    "@tiptap/extension-text-style": "3.33.1",
    "expo": "~58.0.25",
    "expo-dev-client": "~58.0.20",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-local-authentication": "~58.0.3",
    "expo-notifications": "~58.1.9",
    "expo-screen-capture": "~58.0.6",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "react-dom": "19.3.0",
    "typescript": "~7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:fresh": "node scripts/run-android.cjs",
    "android:compare": "node scripts/run-android.cjs compare",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test",
    "editor:build": "vite --config editor-web/vite.config.ts build && node ./node_modules/@10play/tentap-editor/scripts/buildEditor.js ./editor-web/build/index.html",
    "postinstall": "node scripts/patch-draggable-flatlist.cjs && npm run editor:build"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    }
  }
}
