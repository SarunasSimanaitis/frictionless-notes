{
  "name": "frictionless-notes",
  "description": "A calm, offline-first notes and checklist app.",
  "license": "0BSD",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "dependencies": {
    "@10play/tentap-editor": "^1.1.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@tiptap/extension-text-style": "3.32.0",
    "expo": "^58.0.0",
    "expo-file-system": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-notifications": "~58.1.6",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-draggable-flatlist": "4.0.3",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "react-dom": "19.3.0",
    "typescript": "~6.0.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.4",
    "expo-dev-client": "~58.0.15"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --experimental-sqlite --test",
    "editor:build": "vite --config editor-web/vite.config.ts build && node ./node_modules/@10play/tentap-editor/scripts/buildEditor.js ./editor-web/build/index.html",
    "postinstall": "node scripts/patch-draggable-flatlist.cjs && npm run editor:build"
  }
}
